{
  "name": "vega-react-components",
  "version": "1.0.2",
  "description": "A modern React component library",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/vegareact.cjs.js",
  "module": "./dist/vegareact.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vegareact.es.js",
      "require": "./dist/vegareact.cjs.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip --include files,exports,types",
    "publish:ci": "npm run build && npm publish --access public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "lucide-react": ">=0.400.0",
    "react-phone-number-input": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "react-phone-number-input": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@storybook/addon-onboarding": "^10.2.12",
    "@storybook/react-vite": "^10.2.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-storybook": "^10.2.12",
    "globals": "^16.4.0",
    "happy-dom": "^20.8.4",
    "knip": "^5.73.0",
    "lucide-react": "^0.562.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-phone-number-input": "^3.4.16",
    "storybook": "^10.2.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "library",
    "vega"
  ],
  "author": "vegacomponents",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vega-organisation/vegaReact.git"
  }
}
